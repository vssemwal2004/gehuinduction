NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/geu_induction_connect
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
QR_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-chars
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-chars
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
TRUST_PROXY=false
